<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>VisualLab</AssemblyName>
    <RootNamespace>VisualLab</RootNamespace>
    <Version>0.1.2</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SL_MANAGED Condition="'$(SL_MANAGED)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</SL_MANAGED>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="LabApi" HintPath="$(SL_MANAGED)\LabApi.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(SL_MANAGED)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(SL_MANAGED)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="CommandSystem.Core" HintPath="$(SL_MANAGED)\CommandSystem.Core.dll" Private="false" />
    <Reference Include="Mirror" HintPath="$(SL_MANAGED)\Mirror.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SL_MANAGED)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\bindings.json" LogicalName="VisualLab.bindings.json" />
  </ItemGroup>
</Project>
